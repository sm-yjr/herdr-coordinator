#!/usr/bin/env python3
"""Resolve Herdr Coordinator state, then execute the fleet control plane."""

from __future__ import annotations

import os
from pathlib import Path
import sys


PLUGIN_ID = "sm-yjr.herdr-coordinator"
ROOT = Path(__file__).resolve().parent
CORE = ROOT / "fleet_core.py"


def plugin_state_candidates() -> list[Path]:
    if value := os.environ.get("XDG_STATE_HOME"):
        base = Path(value).expanduser()
    else:
        base = Path.home() / ".local" / "state"
    # Stable Herdr uses `herdr`; local debug builds use `herdr-dev`.
    return [base / app / "plugins" / PLUGIN_ID for app in ("herdr", "herdr-dev")]


def resolve_state_environment() -> None:
    # Explicit caller choices always win.
    if os.environ.get("HERDR_PLUGIN_STATE_DIR") or os.environ.get(
        "HERDR_COORDINATOR_HOME"
    ):
        return
    for candidate in plugin_state_candidates():
        if candidate.is_dir():
            os.environ["HERDR_PLUGIN_STATE_DIR"] = str(candidate)
            os.environ.setdefault("HERDR_PLUGIN_ID", PLUGIN_ID)
            return


def main() -> None:
    resolve_state_environment()
    os.execv(sys.executable, [sys.executable, str(CORE), *sys.argv[1:]])


if __name__ == "__main__":
    main()
