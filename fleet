#!/usr/bin/env bash
set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -x "$root/bin/herdr-coordinator" ]; then
  exec "$root/bin/herdr-coordinator" "$@"
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "未找到 herdr-coordinator 二进制；请先运行 scripts/fetch-or-build.sh" >&2
  exit 127
fi

cargo build --quiet --locked --release --manifest-path "$root/tower/Cargo.toml"
exec "$root/tower/target/release/herdr-coordinator" "$@"
