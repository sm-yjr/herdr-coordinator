#!/usr/bin/env python3
"""Resolve shared state, install runtime guards, and dispatch fleet commands."""

from __future__ import annotations

import importlib.util
import os
from pathlib import Path
import sys
from types import ModuleType


PLUGIN_ID = "sm-yjr.herdr-coordinator"
ROOT = Path(__file__).resolve().parent
CORE_PATH = ROOT / "fleet_core.py"


def plugin_state_candidates() -> list[Path]:
    if value := os.environ.get("XDG_STATE_HOME"):
        base = Path(value).expanduser()
    else:
        base = Path.home() / ".local" / "state"
    # Stable Herdr uses `herdr`; local debug builds use `herdr-dev`.
    return [base / app / "plugins" / PLUGIN_ID for app in ("herdr", "herdr-dev")]


def resolve_state_environment() -> None:
    # Explicit caller choices always win.
    if os.environ.get("HERDR_PLUGIN_STATE_DIR") or os.environ.get(
        "HERDR_COORDINATOR_HOME"
    ):
        return
    for candidate in plugin_state_candidates():
        if candidate.is_dir():
            os.environ["HERDR_PLUGIN_STATE_DIR"] = str(candidate)
            os.environ.setdefault("HERDR_PLUGIN_ID", PLUGIN_ID)
            return


def load_core() -> ModuleType:
    spec = importlib.util.spec_from_file_location("herdr_coordinator_fleet_core", CORE_PATH)
    if spec is None or spec.loader is None:
        raise SystemExit(f"无法加载控制面实现: {CORE_PATH}")
    core = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(core)
    return core


def main() -> None:
    resolve_state_environment()
    # The compatibility watcher verifies its PID by matching fleet_core.py in the
    # process command. Preserve that identity for the foreground watch command.
    if len(sys.argv) > 1 and sys.argv[1] == "watch":
        os.execv(sys.executable, [sys.executable, str(CORE_PATH), *sys.argv[1:]])
    core = load_core()
    from fleet_policy import install

    install(core)
    if len(sys.argv) < 2 or sys.argv[1] not in core.COMMANDS:
        print(core.__doc__)
        raise SystemExit(1)
    try:
        core.migrate_legacy_state()
        core.COMMANDS[sys.argv[1]](sys.argv[2:])
    except IndexError:
        print(core.__doc__)
        raise SystemExit(1)


if __name__ == "__main__":
    main()
